<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!-- 发行安装包。由 scripts/publish-release.ps1 调用，不手工编译：
       版本号、发布目录、图标、发布者都由 -d 变量注入，唯一的手工不变量是 UpgradeCode。
       UpgradeCode 标识「这是同一个产品」，对外发行后永不能改——改了升级就变成两份并存安装。
       产品代码由 WiX 按 版本+UpgradeCode+语言 稳定生成，不手写。
       工具链钉在 WiX v5：v6 起二进制发布挂 OSMF 维护费 EULA，对收费软件是持续成本。 -->

  <Package Name="FrameCapture"
           Manufacturer="$(var.Publisher)"
           Version="$(var.Version)"
           UpgradeCode="D13E621E-E92C-43F2-87F6-6C4076F366D9"
           Language="2052"
           Codepage="936"
           InstallerVersion="500"
           Scope="perMachine">

    <!-- 高版本已装则中止，低版本自动先卸。自包含与框架依赖两个包共用同一 UpgradeCode，
         换装另一种打包方式时先卸掉另一份，不会留下两份文件。 -->
    <MajorUpgrade DowngradeErrorMessage="这台电脑上已安装更新版本的 FrameCapture，本次安装中止。" />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="$(var.Icon)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="FrameCapture" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="APPSTARTMENU" Name="FrameCapture" />
    </StandardDirectory>

    <!-- 卸载不碰 HKCU\...\Run\FrameCapture（应用自己写的自启值，见 Services/StartupService.cs）：
         Windows Installer 的 Registry 表只能创建值、没有删除动作，
         RemoveRegistryValue 编译后不落任何表（已实测）。删它只能靠自定义操作，
         而自定义操作一旦失败会让整个卸载报错——宁可留一条指向已删路径的失效值。 -->
    <Feature Id="FrameCaptureMain" Title="FrameCapture" Level="1" ConfigurableDirectory="INSTALLFOLDER">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="AppShortcut" />
    </Feature>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

  </Package>

  <Fragment>
    <!-- 发布目录整棵收进包：以后新增依赖不用回来改这份文件 -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <Component Id="AppShortcut" Directory="APPSTARTMENU">
      <Shortcut Id="StartMenuShortcut" Name="FrameCapture"
                Target="[INSTALLFOLDER]FrameCapture.exe"
                WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
      <RemoveFolder Id="RemoveStartMenu" On="uninstall" />
      <!-- 组件要有键路径；写在应用自己的键下，不碰任何既有软件的键 -->
      <RegistryValue Root="HKCU" Key="Software\FRAMECAPTURE" Name="StartMenuShortcut"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>

  </Fragment>

</Wix>
