<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>FrameCapture.Resident</AssemblyName>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StackTraceSupport>false</StackTraceSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <OptimizationPreference>Size</OptimizationPreference>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>../../assets/FrameCapture.ico</ApplicationIcon>
    <_FcProj>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\FrameCapture\FrameCapture.csproj'))</_FcProj>
    <Version>$([System.Text.RegularExpressions.Regex]::Match($(_FcProj), '&lt;Version&gt;([^&lt;]+)&lt;/Version&gt;').Groups[1].Value)</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../GestureCore/GestureCore.csproj" />
    <Compile Include="../FrameCapture/Core/ResidentProtocol.cs" Link="ResidentProtocol.cs" />
    <Compile Include="../FrameCapture/Core/GestureClock.cs" Link="GestureClock.cs" />
    <Compile Include="../FrameCapture/Core/GestureModifiers.cs" Link="GestureModifiers.cs" />
  </ItemGroup>
</Project>
