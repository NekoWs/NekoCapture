<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>FrameCapture-Codecs-Setup</AssemblyName>
    <ApplicationIcon>..\..\assets\FrameCapture.ico</ApplicationIcon>
    <_FcProj>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\FrameCapture\FrameCapture.csproj'))</_FcProj>
    <Version>$([System.Text.RegularExpressions.Regex]::Match($(_FcProj), '&lt;Version&gt;([^&lt;]+)&lt;/Version&gt;').Groups[1].Value)</Version>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Compile Include="..\Setup\GlobalUsings.cs" Link="Shared\GlobalUsings.cs" />
    <Compile Include="..\Setup\Win32Shim.cs" Link="Shared\Win32Shim.cs" />
    <Compile Include="..\Setup\OsVersionShim.cs" Link="Shared\OsVersionShim.cs" />
    <Compile Include="..\FrameCapture\Core\Fluent.cs" Link="Shared\Fluent.cs" />
    <Compile Include="..\FrameCapture\Core\Fluent.ThemeFade.cs" Link="Shared\Fluent.ThemeFade.cs" />
    <Compile Include="..\FrameCapture\Core\Fluent.Controls.cs" Link="Shared\Fluent.Controls.cs" />
    <Compile Include="..\FrameCapture\Core\Fluent.Color.cs" Link="Shared\Fluent.Color.cs" />
    <Compile Include="..\FrameCapture\Core\Fluent.Styles.cs" Link="Shared\Fluent.Styles.cs" />
    <Compile Include="..\FrameCapture\Core\Theme.cs" Link="Shared\Theme.cs" />
    <Compile Include="..\FrameCapture\Core\Loc.cs" Link="Shared\Loc.cs" />
    <Compile Include="..\FrameCapture\Core\Str.cs" Link="Shared\Str.cs" />
    <Compile Include="..\FrameCapture\Core\Strings\CodecSetup.cs" Link="Shared\Strings.cs" />
    <Compile Include="..\FrameCapture\Core\Strings\Common.cs" Link="Shared\Common.cs" />
    <Compile Include="..\FrameCapture\Encoding\FfmpegComponentInfo.cs" Link="Shared\FfmpegComponentInfo.cs" />
    <Compile Include="..\FrameCapture\Encoding\ComponentInstaller.cs" Link="Shared\ComponentInstaller.cs" />
    <Compile Include="..\FrameCapture\Encoding\ComponentDownloader.cs" Link="Shared\ComponentDownloader.cs" />
    <Compile Include="..\FrameCapture\Encoding\ComponentProgress.cs" Link="Shared\ComponentProgress.cs" />
  </ItemGroup>
</Project>
