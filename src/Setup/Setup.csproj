<Project Sdk="Microsoft.NET.Sdk">

  <!-- 安装引导器：刻意钉在 .NET Framework 4.8，让它在任何能跑主程序的机器上免前置直接双击运行。
       Windows 10 2004（主程序 TFM 下限 10.0.19041）起系统自带 4.8，因此不存在「引导器自己起不来」。
       主程序需要 .NET 8 是因为 WGC 捕获与 Windows.Media.Ocr，引导器两者都不碰。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 链入主程序的主题源码，其中用到文件作用域命名空间与目标类型 new()，4.8 默认 7.3 不够 -->
    <LangVersion>latest</LangVersion>
    <!-- 链入的源文件按主项目的隐式 using 写就（Action、IntPtr 等未显式 using System）。
         这里不用 ImplicitUsings：WinForms 的隐式集会把 System.Drawing / System.Windows.Forms
         灌进来，与 WPF 的 Button / Color / Brush 撞名，改由 GlobalUsings.cs 精确声明。 -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>FrameCapture-Setup</AssemblyName>
    <RootNamespace>FrameCapture.Setup</RootNamespace>
    <!-- 32 位进程写 Program Files 与注册表会被 WOW64 重定向，必须 x64 -->
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>..\..\assets\FrameCapture.ico</ApplicationIcon>
    <!-- 不引 WinForms：主程序那份 Win32.cs 里有一处 WinForms 互操作，引导器改用本地 Win32Shim.cs，
         只声明圆角与分层窗口这几项，签名与主程序逐字一致 -->
    <UseWindowsForms>false</UseWindowsForms>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- 版本号从主程序工程文件读，不在此处再写一遍：发行时两处版本对不上是常见事故源 -->
    <_FcProj>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\FrameCapture\FrameCapture.csproj'))</_FcProj>
    <Version>$([System.Text.RegularExpressions.Regex]::Match($(_FcProj), '&lt;Version&gt;([^&lt;]+)&lt;/Version&gt;').Groups[1].Value)</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- 4.8 默认不带这两个程序集：前者下载运行时，后者解包主程序载荷 -->
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Xml.Linq" />
    <!-- dynamic 调 WScript.Shell 建快捷方式所需 -->
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- 与主程序共用同一份视觉语言源文件，不是复刻：颜色、动效令牌、控件模板单一来源 -->
    <Compile Include="..\FrameCapture\Core\Str.cs" Link="Shared\Str.cs" />
    <Compile Include="..\FrameCapture\Core\Strings\Common.cs" Link="Shared\Strings\Common.cs" />
    <Compile Include="..\FrameCapture\Core\Strings\Setup.cs" Link="Shared\Strings\Setup.cs" />
    <Compile Include="..\FrameCapture\Core\Theme.cs" Link="Shared\Theme.cs" />
    <Compile Include="..\FrameCapture\Services\StartupRegistration.cs" Link="Shared\StartupRegistration.cs" />
    <Compile Include="..\FrameCapture\Services\StartupResult.cs" Link="Shared\StartupResult.cs" />
    <Compile Include="..\FrameCapture\Core\Fluent.cs" Link="Shared\Fluent.cs" />
    <Compile Include="..\FrameCapture\Core\Fluent.ThemeFade.cs" Link="Shared\Fluent.ThemeFade.cs" />
    <Compile Include="..\FrameCapture\Core\Fluent.Controls.cs" Link="Shared\Fluent.Controls.cs" />
    <Compile Include="..\FrameCapture\Core\Fluent.Color.cs" Link="Shared\Fluent.Color.cs" />
    <Compile Include="..\FrameCapture\Core\Fluent.Styles.cs" Link="Shared\Fluent.Styles.cs" />
  </ItemGroup>

  <!-- 发行构建由 publish-release.ps1 传入载荷路径；本地直接 build 时缺省，
       运行时退回读 exe 同目录的 payload.zip，便于不发布也能试装 -->
  <ItemGroup Condition="'$(PayloadZip)' != ''">
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="FrameCapture.Setup.payload.zip" />
  </ItemGroup>

</Project>
